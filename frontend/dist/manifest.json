      "icons": [{ "src": "/icons/icon-96.svg", "sizes": "96x96", "type": "image/svg+xml" }]
    },
    {
      "name": "Tải MP3 nhanh",
      "short_name": "MP3",
      "description": "Chuyển video sang nhạc MP3",
      "url": "/?tool=mp3",
