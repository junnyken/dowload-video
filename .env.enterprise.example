# =============================================================================
# VidGrab Enterprise — Environment Configuration Template
# =============================================================================
# Copy this file:  cp .env.enterprise.example .env.enterprise
# Then fill in ALL values marked <REPLACE_ME> before starting the stack.
#
# Generate secrets quickly:
#   openssl rand -hex 32          → 64-char hex (for JWT_SECRET, WEBHOOK_SECRET_KEY, etc.)
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
#                                 → bcrypt hash for ADMIN_PASSWORD_HASH
#   base64 cookies.txt            → base64-encode Netscape cookie files
#
# Or run the helper:  bash scripts/setup-enterprise.sh
# =============================================================================


# -----------------------------------------------------------------------------
# Application identity
# -----------------------------------------------------------------------------

# Semantic version — visible in /health and admin dashboard
APP_VERSION=2.0.0-enterprise

# Runtime mode — always "production" for deployed enterprise installs
ENV=production


# -----------------------------------------------------------------------------
# Enterprise licensing
# -----------------------------------------------------------------------------

# License key issued by the VidGrab team after purchase.
# Format: base64(JSON payload) + HMAC-SHA256 signature component.
# Leave blank to run in unlicensed mode (limited features).
ENTERPRISE_LICENSE_KEY=<REPLACE_ME>

# Secret used server-side to verify HMAC signature on the license key.
# Provided by VidGrab team alongside the license key — do NOT share.
ENTERPRISE_LICENSE_SECRET=<REPLACE_ME>

# Enables enterprise-only code paths (billing API, RBAC, audit log, etc.)
ENTERPRISE_MODE=true


# -----------------------------------------------------------------------------
# Database — local PostgreSQL (recommended for fully self-hosted)
# -----------------------------------------------------------------------------

# Full DSN consumed by SQLAlchemy / asyncpg.
# Pattern: postgresql+asyncpg://USER:PASS@HOST:PORT/DB
POSTGRES_URL=postgresql+asyncpg://vidgrab:<REPLACE_ME>@postgres:5432/vidgrab

# Credentials used by the postgres service itself (must match POSTGRES_URL above)
POSTGRES_DB=vidgrab
POSTGRES_USER=vidgrab
POSTGRES_PASSWORD=<REPLACE_ME>


# -----------------------------------------------------------------------------
# Database — Supabase cloud (alternative to local Postgres)
# Leave all three blank if you're using the local postgres service above.
# -----------------------------------------------------------------------------

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase anon key (public, safe to expose in browser requests)
SUPABASE_KEY=

# Supabase service-role key (full bypass — KEEP SECRET, server-side only)
SUPABASE_SERVICE_KEY=


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Used as Celery broker, result backend, and application cache.
# Points to the internal redis service; change only if using external Redis.
REDIS_URL=redis://redis:6379/0

# Memory cap for the Redis container (docker-compose.enterprise.yml)
REDIS_MAXMEMORY=1gb


# -----------------------------------------------------------------------------
# Auth & security
# -----------------------------------------------------------------------------

# 64-char random hex — signs JWT access tokens. Rotate = all sessions invalidated.
JWT_SECRET=<REPLACE_ME>

# 64-char random hex — HMAC key for outbound webhook payloads.
# Receiving endpoints should verify: HMAC-SHA256(body, WEBHOOK_SECRET_KEY).
WEBHOOK_SECRET_KEY=<REPLACE_ME>

# Bootstrap admin account — created automatically on first boot if not present.
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password (cost factor 12 recommended).
# Generate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'pass', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=<REPLACE_ME>


# -----------------------------------------------------------------------------
# Frontend & CORS
# -----------------------------------------------------------------------------

# Public URL where the frontend is served (no trailing slash).
# Used in email links, OAuth redirects, and CORS allow-list.
FRONTEND_URL=https://vidgrab.yourdomain.com

# Comma-separated list of origins allowed by the backend CORS middleware.
# Typically the same as FRONTEND_URL; add extras for admin dashboards etc.
CORS_ORIGINS=https://vidgrab.yourdomain.com


# -----------------------------------------------------------------------------
# Download settings
# -----------------------------------------------------------------------------

# Absolute path inside the container where downloaded files are stored.
# Mapped to the `downloads` Docker volume — do not change without updating compose.
DOWNLOAD_DIR=/app/downloads

# Maximum number of concurrent yt-dlp processes per worker.
MAX_CONCURRENT_DOWNLOADS=8

# Maximum total disk space (GB) consumed by the downloads volume before
# the oldest files are auto-purged.
DOWNLOADS_MAX_GB=50

# Per-IP daily download limit (0 = disabled / unlimited).
# Useful to prevent abuse on public-facing installs.
DAILY_QUOTA_PER_IP=0


# -----------------------------------------------------------------------------
# Platform cookies (base64-encoded Netscape cookie files)
# -----------------------------------------------------------------------------
# Export from your browser with a "cookies.txt" extension, then encode:
#   base64 -w 0 cookies.txt
#
# YouTube — required for age-restricted + private videos; also pairs with
# the PO Token service to bypass bot-detection.
YOUTUBE_COOKIES_B64=

# Instagram — required for private/story content.
INSTAGRAM_COOKIES_B64=

# X/Twitter — required for age-gated media.
TWITTER_COOKIES_B64=

# TikTok — improves reliability for region-locked content.
TIKTOK_COOKIES_B64=

# Facebook — required for private/group video downloads.
FACEBOOK_COOKIES_B64=


# -----------------------------------------------------------------------------
# Proxy — DataImpulse residential proxy pool
# -----------------------------------------------------------------------------
# YouTube blocks datacenter IPs even with valid cookies + PO tokens.
# A residential proxy is REQUIRED for reliable YouTube downloads.
# Top up balance at: https://dataimpulse.com

# Full proxy URL (overrides individual user/pass below if set).
# Format: http://USER:PASS@HOST:PORT
PROXY_URL=

# DataImpulse credentials (used when PROXY_URL is blank)
DATAIMPULSE_USER=
DATAIMPULSE_PASS=

# Set to 1 to route all YouTube downloads through the proxy (recommended).
YOUTUBE_PROXY_DOWNLOAD=1


# -----------------------------------------------------------------------------
# Spotify integration (optional — enables Spotify→YouTube matching)
# -----------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Two-letter market code for Spotify track lookups.
SPOTIFY_MARKET=VN


# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------

# Sentry DSN — errors and performance traces sent here.
# Leave blank to disable Sentry integration.
SENTRY_DSN=

# Telegram ops bot — receives health alerts and error notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram webhook secret (verifies payloads from Telegram's servers).
TELEGRAM_BOT_SECRET=

# Celery worker concurrency tuning
CELERY_DOWNLOADS_CONCURRENCY=4
CELERY_LIGHT_CONCURRENCY=4
