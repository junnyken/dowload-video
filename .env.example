# ── Supabase (bắt buộc) ──────────────────────────────────────────────
# Tạo project tại https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# anon key (public) — dùng cho frontend + RLS queries
SUPABASE_KEY=eyJhbGci...anon...

# ── Supabase Auth (mới — cho user auth layer) ────────────────────────
# service_role key — CHỈ dùng backend, KHÔNG expose frontend
# Lấy tại: Project Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJhbGci...service_role...

# ── Proxy-Cheap (https://app.proxy-cheap.com/) ──────────────────────
# Khuyến nghị: Quản lý trực tiếp trên giao diện Admin (/vid-admin/proxy) để tự động
# lưu vào Redis (hỗ trợ main/backup failover + test proxy sống/chết tự động).
# Các biến môi trường bên dưới đóng vai trò fallback khi Redis pool trống:
# - Không cần tách biệt nhà cung cấp Datacenter vs Residential: chỉ cần dùng
#   Proxy-Cheap (https://app.proxy-cheap.com/) kết hợp cơ chế:
#   1) Nền tảng thông thường (TikTok, FB, IG, Threads, Pinterest...): Tải trực tiếp
#      bằng IP VPS trước ($0). Chỉ khi bị chặn IP mới fallback sang PROXY_POOL_ALL
#      ở bước lấy metadata (tải file video luôn đi thẳng từ CDN không tốn băng thông proxy).
#   2) YouTube: Dùng proxy cố định / sticky session trong PROXY_POOL_YT (hoặc PROXY_POOL_YT_STATIC).
PROXY_CHEAP_PROXY=
PROXY_CHEAP_PROXY_CN=
IPROYAL_PROXY=
PROXY_POOL_ALL=
PROXY_POOL_YT=
PROXY_POOL_YT_STATIC=
PROXY_POOL_TT=
PROXY_POOL_FB=
PROXY_POOL_IG=
PROXY_POOL_CN=
PROXY_POOL_TW=
PROXY_POOL_REDDIT=
PROXY_POOL_DEFAULT=
# Bật YouTube (có thể bật/tắt trực tiếp trên Admin /vid-admin/youtube không cần restart)
YOUTUBE_ENABLED=true
YOUTUBE_PROXY_DOWNLOAD=1
YOUTUBE_PROXY_DAILY_LIMIT_GB=2

# ── Telegram (tuỳ chọn — nhận thông báo lỗi) ────────────────────────
# Tạo bot: chat với @BotFather trên Telegram → /newbot
# Lấy chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web Push (tuỳ chọn — thông báo trình duyệt khi tải xong) ────────
# Không đặt PUSH_VAPID_PRIVATE_KEY = push tắt (không lỗi). Khoá công khai
# trình duyệt nhận qua GET /api/v1/push/vapid-key (suy ra từ khoá riêng),
# nên đổi khoá không cần build lại frontend. Chi tiết: backend/app/core/push_sender.py
# PUSH_VAPID_PRIVATE_KEY=<base64url 32 byte>
# PUSH_VAPID_PUBLIC_KEY=<base64url, tuỳ chọn — phải khớp khoá riêng>
# PUSH_VAPID_SUBJECT=mailto:<email vận hành>

# ── YouTube Cookies (khuyến nghị) ────────────────────────────────────
# Export cookies từ Chrome bằng extension "Get cookies.txt LOCALLY"
# Sau đó encode base64: base64 -w 0 cookies.txt
YOUTUBE_COOKIES_B64=

# ── TikTok / Facebook / Instagram / Twitter Cookies (tuỳ chọn) ──────
# Khuyến nghị: Quản lý trực tiếp trên Admin (/vid-admin/cookies) để hỗ trợ xoay vòng nhiều cookie.
TIKTOK_COOKIES_B64=
FACEBOOK_COOKIES_B64=
INSTAGRAM_COOKIES_B64=
TWITTER_COOKIES_B64=

# ── Spotify (tuỳ chọn — tìm bài theo tên) ──────────────────────────
# Tạo app tại https://developer.spotify.com
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# ── Redis (mặc định, không cần đổi nếu dùng docker-compose) ─────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── App settings ─────────────────────────────────────────────────────
ENV=production
DOWNLOADS_MAX_GB=10
DAILY_QUOTA_PER_IP=50
VIDEO_INFO_CACHE_TTL=600
# Free tier daily limit per user (0 = disabled)
FREE_DAILY_LIMIT=50

# ── Admin dashboard ──────────────────────────────────────────────────
# REQUIRED. There is no default — leaving this empty makes POST /admin/login
# answer 503 and locks you out of the dashboard entirely.
ADMIN_PASSWORD=
# Optional comma-separated IP allowlist for every /admin endpoint. Empty means
# any IP may attempt to authenticate; attempts are still counted and the IP is
# locked out for 15 minutes after 3 failures in 5 minutes.
ADMIN_ALLOWED_IPS=

# ── Thanh toán Quốc tế (Stripe) & RapidAPI Marketplace ───────────────
# Điền STRIPE_SECRET_KEY và STRIPE_WEBHOOK_SECRET từ https://dashboard.stripe.com/
# Nếu không điền STRIPE_PRO_PRICE_ID, hệ thống tự động tạo gói $4.99/tháng & $49/năm.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEAR_PRICE_ID=
STRIPE_PRO_MONTH_USD_CENTS=499
STRIPE_PRO_YEAR_USD_CENTS=4900

# RapidAPI Proxy Secret (lấy từ RapidAPI Studio -> Security -> X-RapidAPI-Proxy-Secret)
RAPIDAPI_PROXY_SECRET=
