# ── Supabase (bắt buộc) ──────────────────────────────────────────────
# Tạo project tại https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# anon key (public) — dùng cho frontend + RLS queries
SUPABASE_KEY=eyJhbGci...anon...

# ── Supabase Auth (mới — cho user auth layer) ────────────────────────
# service_role key — CHỈ dùng backend, KHÔNG expose frontend
# Lấy tại: Project Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJhbGci...service_role...

# ── Proxy (bắt buộc cho YouTube/TikTok) ─────────────────────────────
# IPRoyal residential proxy: https://iproyal.com
IPROYAL_PROXY=http://username:password@geo.iproyal.com:12321

# ── Telegram (tuỳ chọn — nhận thông báo lỗi) ────────────────────────
# Tạo bot: chat với @BotFather trên Telegram → /newbot
# Lấy chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── YouTube Cookies (khuyến nghị) ────────────────────────────────────
# Export cookies từ Chrome bằng extension "Get cookies.txt LOCALLY"
# Sau đó encode base64: base64 -w 0 cookies.txt
YOUTUBE_COOKIES_B64=

# ── TikTok / Facebook Cookies (tuỳ chọn) ────────────────────────────
TIKTOK_COOKIES_B64=
FACEBOOK_COOKIES_B64=

# ── Spotify (tuỳ chọn — tìm bài theo tên) ──────────────────────────
# Tạo app tại https://developer.spotify.com
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# ── Redis (mặc định, không cần đổi nếu dùng docker-compose) ─────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── App settings ─────────────────────────────────────────────────────
ENV=production
DOWNLOADS_MAX_GB=10
DAILY_QUOTA_PER_IP=50
VIDEO_INFO_CACHE_TTL=600
# Free tier daily limit per user (0 = disabled)
FREE_DAILY_LIMIT=50

# ── Admin dashboard ──────────────────────────────────────────────────
# REQUIRED. There is no default — leaving this empty makes POST /admin/login
# answer 503 and locks you out of the dashboard entirely.
ADMIN_PASSWORD=
# Optional comma-separated IP allowlist for every /admin endpoint. Empty means
# any IP may attempt to authenticate; attempts are still counted and the IP is
# locked out for 15 minutes after 3 failures in 5 minutes.
ADMIN_ALLOWED_IPS=
