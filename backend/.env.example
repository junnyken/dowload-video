# Supabase Credentials
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here

# Cookie pool encryption at rest (task #6402). NOT required: the key is derived
# from SUPABASE_SERVICE_KEY. Set only to rotate away from that derived key
# (base64 of exactly 32 bytes). Without either, cookies are stored unencrypted.
# COOKIE_POOL_ENCRYPTION_KEY=
