{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "C1: the main window may call only the commands of docs/desktop/C1-CONTRACT.md and listen to their events. No shell, fs, dialog, opener, http, updater, notification or autostart permissions are granted to the webview; folder picking, revealing and opening files, toasts and the Windows Run key happen in Rust. Only the window labelled \"main\" gets these; the login-<platform> and resolve-douyin-<random> windows (remote platform pages, PLAN-32D) get none.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-probe",
    "allow-cancel-probe",
    "allow-start-download",
    "allow-pause-download",
    "allow-cancel-download",
    "allow-pick-folder",
    "allow-default-download-dir",
    "allow-disk-free",
    "allow-reveal-path",
    "allow-open-path",
    "allow-open-url",
    "allow-history-list",
    "allow-history-add",
    "allow-history-delete",
    "allow-history-clear",
    "allow-history-mark-synced",
    "allow-auth-save",
    "allow-auth-load",
    "allow-auth-clear",
    "allow-browser-login",
    "allow-cancel-browser-login",
    "allow-get-version",
    "allow-device-info",
    "allow-tool-versions",
    "allow-channel-fetch",
    "allow-cancel-channel-fetch",
    "allow-channel-save",
    "allow-channel-list",
    "allow-channel-delete",
    "allow-channel-seen-add",
    "allow-channel-seen-list",
    "allow-notify",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-set-close-to-tray",
    "allow-cookies-login-open",
    "allow-cookies-login-finish",
    "allow-cookies-status",
    "allow-cookies-clear",
    "allow-douyin-resolve-local"
  ]
}
