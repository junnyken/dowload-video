{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_ext_name__",
  "version": "5.22.4",
  "description": "__MSG_ext_description__",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "scripting",
    "notifications",
    "contextMenus",
    "alarms",
    "cookies",
    "webRequest",
    "offscreen",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "clipboardRead",
    "tabCapture"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.facebook.com/*",
    "*://*.douyin.com/*",
    "*://*.instagram.com/*",
    "*://open.spotify.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.reddit.com/*",
    "*://*.pinterest.com/*",
    "*://*.threads.com/*",
    "*://*.threads.net/*",
    "*://*.bilibili.com/*",
    "*://b23.tv/*",
    "*://*.xiaohongshu.com/*",
    "*://*.rednote.com/*",
    "*://*.xhslink.com/*",
    "*://*.lemon8-app.com/*",
    "*://*.lemon8.app/*",
    "*://*.snapchat.com/*",
    "*://story.snapchat.com/*",
    "*://*.vk.com/*",
    "*://*.twitch.tv/*",
    "*://*.rumble.com/*",
    "*://*.odysee.com/*",
    "*://*.dailymotion.com/*",
    "*://*.soundcloud.com/*",
    "*://dvid.vibe1.tinhgon.xyz/*",
    "*://dvid-api.vibe1.tinhgon.xyz/*",
    "*://dowloadvideo.io.vn/*",
    "*://*.douyinvod.com/*",
    "*://*.douyincdn.com/*",
    "*://*.zjcdn.com/*",
    "*://*.bytecdn.cn/*",
    "*://*.amemv.com/*",
    "*://*.snssdk.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_ext_action_title__"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.threads.com/*",
        "*://*.threads.net/*",
        "*://*.bilibili.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.rednote.com/*",
        "*://*.lemon8-app.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.douyin.com/*",
        "*://*.instagram.com/*",
        "*://open.spotify.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.pinterest.com/*",
        "*://*.threads.com/*",
        "*://*.threads.net/*",
        "*://*.bilibili.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.rednote.com/*",
        "*://*.xhslink.com/*",
        "*://*.lemon8-app.com/*",
        "*://*.snapchat.com/*",
        "*://*.vk.com/*",
        "*://*.twitch.tv/*",
        "*://*.rumble.com/*",
        "*://*.odysee.com/*",
        "*://*.dailymotion.com/*",
        "*://*.soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://dvid.vibe1.tinhgon.xyz/*",
        "*://dowloadvideo.io.vn/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
